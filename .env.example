# Copy to .env.local and fill in. .env.local is gitignored.

# --- Default: OpenRouter (free tier) ---
GROUNDTRUTH_BASE_URL=https://openrouter.ai/api/v1
GROUNDTRUTH_MODEL=google/gemma-4-31b-it:free
GROUNDTRUTH_API_KEY=sk-or-v1-replace-me

# Optional, OpenRouter only: comma-separated models to try in order when the
# primary errors or is rate limited. Every entry must support JSON mode.
GROUNDTRUTH_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Fallback: local Ollama ($0 by construction, offline) ---
# GROUNDTRUTH_BASE_URL=http://localhost:11434/v1
# GROUNDTRUTH_MODEL=qwen2.5:3b
# GROUNDTRUTH_API_KEY=ollama

# Deterministic canned responses, no network, no key required.
# Used by CI and the contract verifier. Set to 1 to enable.
GROUNDTRUTH_FAKE_LLM=0
