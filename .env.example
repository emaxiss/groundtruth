# Copy to .env.local and fill in. .env.local is gitignored.

# --- Default: OpenRouter (free tier) ---
GROUNDTRUTH_BASE_URL=https://openrouter.ai/api/v1
GROUNDTRUTH_MODEL=google/gemma-4-31b-it:free
GROUNDTRUTH_API_KEY=sk-or-v1-replace-me

# Optional, OpenRouter only: comma-separated models to try in order when the
# primary errors or is rate limited. Every entry must support JSON mode.
GROUNDTRUTH_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nex-agi/nex-n2.5-pro:free

# --- Fallback: local Ollama ($0 by construction, offline) ---
# GROUNDTRUTH_BASE_URL=http://localhost:11434/v1
# GROUNDTRUTH_MODEL=qwen2.5:3b
# GROUNDTRUTH_API_KEY=ollama

# Judge tier (evals only, never called by the app). A different family from the
# agent's model, so it is not grading its own answers. Same ":free" rule.
GROUNDTRUTH_JUDGE_MODEL=nex-agi/nex-n2.5-pro:free
GROUNDTRUTH_JUDGE_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-super-120b-a12b:free
# DeepEval telemetry is opt-out; keep it off.
DEEPEVAL_TELEMETRY_OPT_OUT=1
# Thresholds; defaults are the calibrated values documented in evals/README.md.
# GROUNDTRUTH_JUDGE_RELEVANCY_MIN=0.5
# GROUNDTRUTH_JUDGE_CORRECTNESS_MIN=0.5

# Every model id must end in ":free" or the client refuses to call it, so an
# account with credit cannot be charged by a typo. Set to 1 to opt in to paid
# models.
GROUNDTRUTH_ALLOW_PAID_MODELS=0

# Deterministic canned responses, no network, no key required.
# Used by CI, the contract verifier, and the eval harness. Set to 1 to enable.
GROUNDTRUTH_FAKE_LLM=0
