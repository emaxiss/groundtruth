{
  "name": "groundtruth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI customer-support agent built to be measured: a Next.js agent under test, graded black-box over HTTP by a Python eval harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxiss/groundtruth.git"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "grounding": "node scripts/print-grounding.mts",
    "test:contract": "playwright test --project=contract",
    "redteam": "PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 pnpm dlx promptfoo@0.123.1 eval -c redteam/promptfooconfig.yaml --no-cache -j 1 -o redteam/results/latest.json",
    "evals:validate": "python3 evals/tools/validate_dataset.py",
    "evals:typecheck": "cd evals && python3 -m mypy",
    "evals:unit": "cd evals && python3 -m pytest tests --cov --cov-report=term",
    "evals:deterministic": "python3 -m pytest evals -m \"not judge\"",
    "evals:judge": "python3 -m pytest evals -m \"judge and not agreement\"",
    "evals:agreement": "python3 -m pytest evals -m agreement",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.5",
    "openai": "^7.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
