{
  "name": "groundtruth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI customer-support agent built to be measured: a Next.js agent under test, graded black-box over HTTP by a Python eval harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaxiss/groundtruth.git"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "grounding": "node scripts/print-grounding.mts",
    "verify:contract": "node tests/contract/verify-contract.mjs",
    "evals:validate": "python3 evals/tools/validate_dataset.py",
    "evals:deterministic": "python3 -m pytest evals -m \"not judge\"",
    "evals:judge": "python3 -m pytest evals -m judge",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.2.10",
    "openai": "^6.48.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
